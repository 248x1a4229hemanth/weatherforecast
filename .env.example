# WeatherSphere Environment Configuration

# GEMINI_API_KEY: Required for optional Gemini AI weather insights.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key.
# If omitted, WeatherSphere automatically uses the built-in Open-Meteo & WMO global sensory array (zero configuration required).
OPENWEATHER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT=3000
